<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Color when the item is pressed (clicked) -->
    <item android:state_pressed="true" android:drawable="@color/red_7" />

    <!-- Color when the item is focused -->
    <item android:state_focused="true" android:drawable="@color/red_7" />

    <!-- Default color -->
    <item android:drawable="@color/red_7" />
</selector>