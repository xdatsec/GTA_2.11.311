<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="0dp"
    android:insetRight="0dp"
    android:insetTop="0dp"
    android:insetBottom="0dp">

    <shape android:shape="rectangle">
        <!-- گرادیانت با شفافیت بیشتر و رنگ های نزدیک تر برای حس شیشه ای -->
        <gradient
            android:startColor="#33FFFFFF"
            android:endColor="#22FFFFFF"
            android:angle="225"
            android:centerX="50%"
            android:centerColor="#22FFFFFF" />
        <!--
            startColor:  سفید با 20% شفافیت
            endColor:    سفید با 13% شفافیت
            centerColor: سفید با 13% شفافیت
            angle:       زاویه ملایم
        -->

        <corners android:radius="30dp"/>

        <!-- اضافه کردن حاشیه شفاف و کم رنگ برای حس بهتر شیشه ای -->
        <stroke
            android:width="1dp"
            android:color="#44FFFFFF" /> <!-- سفید با 27% شفافیت -->
    </shape>
</inset>

