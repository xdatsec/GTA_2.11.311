<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#050000"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="520dp"
                android:centerX="0.5"
                android:centerY="0.15"
                android:startColor="#33FF1E1E"
                android:centerColor="#0f0000"
                android:endColor="#00000000"/>
        </shape>
    </item>

</layer-list>
