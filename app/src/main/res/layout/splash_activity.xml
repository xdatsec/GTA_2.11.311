<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Background (Black + Red Accent) -->
    <View
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Soft red glow circle (depth) -->
    <View
        android:id="@+id/redGlow"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="36dp"
        android:alpha="0.9"
        android:background="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/appLogo"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/king"
        app:layout_constraintBottom_toBottomOf="@id/redGlow"
        app:layout_constraintEnd_toEndOf="@id/redGlow"
        app:layout_constraintStart_toStartOf="@id/redGlow"
        app:layout_constraintTop_toTopOf="@id/redGlow" />

    <!-- Title + Subtitle -->
    <LinearLayout
        android:id="@+id/appNameLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/redGlow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.92">

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="Reality Life Roleplay"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#D9FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Center card (status + loading vortex) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/centerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginHorizontal="20dp"
        android:padding="18dp"
        android:background="@drawable/bg_card_vortex_modern"
        app:layout_constraintTop_toBottomOf="@id/appNameLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.94">

        <!-- 🔴 Halo / glow behind icon -->
        <View
            android:id="@+id/iconGlow"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_vortex_glow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- 🌀 Vortex spinner -->
        <ImageView
            android:id="@+id/loadingIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_loading"
            app:layout_constraintBottom_toBottomOf="@id/iconGlow"
            app:layout_constraintEnd_toEndOf="@id/iconGlow"
            app:layout_constraintStart_toStartOf="@id/iconGlow"
            app:layout_constraintTop_toTopOf="@id/iconGlow" />

        <!-- 📝 Status text -->
        <LinearLayout
            android:id="@+id/statusLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="18dp"
            app:layout_constraintStart_toEndOf="@id/iconGlow"
            app:layout_constraintTop_toTopOf="@id/iconGlow"
            app:layout_constraintBottom_toBottomOf="@id/iconGlow"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.03"
                android:text="Checking for update "
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Please wait a moment "
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Bottom brand line -->
    <TextView
        android:id="@+id/bottomLine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:text="©DigitalByteSolution"
        android:textColor="#88FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.92" />

    <!-- GPU invisible container you used in code -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gpu"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0.0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
