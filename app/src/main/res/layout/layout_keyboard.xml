<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/keyboard_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/keyboard_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="@dimen/_4sdp"
        android:paddingRight="@dimen/_4sdp"
        android:paddingBottom="@dimen/_4sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/main_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_3sdp"
            android:background="@drawable/chat_input_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/_8sdp"
            android:paddingTop="@dimen/_3sdp"
            android:paddingRight="@dimen/_8sdp"
            android:paddingBottom="@dimen/_3sdp">

            <com.rockstargames.gtasa.launcher.util.CustomEditText
                android:id="@+id/main_et_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_8sdp"
                android:layout_weight="1"
                android:ems="10"
                android:fontFamily="@font/montserrat_medium"
                android:imeOptions="actionUnspecified|actionGo|actionSend|actionDone|flagNoFullscreen|flagNoExtractUi"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:singleLine="true"
                android:textColor="#F7FDFF"
                android:textColorHint="#A8D4F0FF"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:textSize="17sp" />

            <Button
                android:id="@+id/main_but_input_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginRight="@dimen/_4sdp"
                android:background="@drawable/chat_input_button"
                android:fontFamily="@font/montserrat_black"
                android:gravity="center"
                android:minWidth="34dp"
                android:minHeight="34dp"
                android:text="&#x22C1;"
                android:textColor="#ECFBFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/main_but_input_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginRight="@dimen/_4sdp"
                android:background="@drawable/chat_input_button"
                android:fontFamily="@font/montserrat_black"
                android:gravity="center"
                android:minWidth="34dp"
                android:minHeight="34dp"
                android:text="&#x22C0;"
                android:textColor="#ECFBFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/main_but_input_slash"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginRight="@dimen/_4sdp"
                android:background="@drawable/chat_input_button"
                android:fontFamily="@font/montserrat_black"
                android:gravity="center"
                android:minWidth="34dp"
                android:minHeight="34dp"
                android:text="/"
                android:textColor="#ECFBFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keyboard_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/chat_input_background"
            android:orientation="vertical"
            android:paddingLeft="@dimen/_6sdp"
            android:paddingRight="@dimen/_6sdp"
            android:paddingTop="@dimen/_4sdp"
            android:paddingBottom="@dimen/_4sdp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
