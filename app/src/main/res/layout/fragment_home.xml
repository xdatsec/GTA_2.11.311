<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="20dp">

    <!-- ================= TITLE ================= -->
    <!-- LOGO (you will set src yourself) -->

    <View
        android:id="@+id/redGlow"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="32dp"
        android:alpha="0.9"
        android:background="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/homeLogo"
        android:layout_width="200dp"
        android:layout_height="120dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/king"
        app:layout_constraintBottom_toBottomOf="@id/redGlow"
        app:layout_constraintEnd_toEndOf="@id/redGlow"
        app:layout_constraintStart_toStartOf="@id/redGlow"
        app:layout_constraintTop_toTopOf="@id/redGlow" />

    <!-- TITLE -->
    <TextView
        android:id="@+id/homeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:text="Reality Life Roleplay"
        android:textColor="#F4ECEC"
        android:textSize="31sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/redGlow" />

    <TextView
        android:id="@+id/homeSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/akrobat_bold"
        android:textColor="#B3EBE2E2"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeTitle" />


    <!-- ================= SERVER BUTTON CARD ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/serverCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeSubtitle">

        <!-- BUTTON -->
        <Button
            android:id="@+id/btnPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/lines"
            android:letterSpacing="0.12"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp"
            android:stateListAnimator="@null"
            android:text="PLAY"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- SUBTITLE -->

        <!-- DESCRIPTION -->

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= QUICK ACTIONS ================= -->
    <LinearLayout
        android:id="@+id/quickActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/serverCard">

        <ImageView
            android:id="@+id/discordBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_quick_icon"
            android:padding="14dp"
            android:src="@drawable/discord_logo" />

        <ImageView
            android:id="@+id/webBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_quick_icon"
            android:padding="14dp"
            android:src="@drawable/internet"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/youtubeBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_quick_icon"
            android:padding="14dp"
            android:src="@drawable/youtube_logo" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
