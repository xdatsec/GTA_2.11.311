<?xml version="1.0" encoding="utf-8" ?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainfuck"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_box"
        android:layout_width="@dimen/_387sdp"
        android:layout_height="wrap_content"
        android:layout_marginStart="130dp"
        android:paddingBottom="15dp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <com.digitalbyte.samp.game.ui.FadingEdgeLayout
            android:id="@+id/chat_fade_box"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_105sdp"
            android:minHeight="@dimen/_85sdp"
            app:fel_edge="top"
            app:fel_size_top="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.factor.bouncy.BouncyRecyclerView
                android:id="@+id/chat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:clipToPadding="false"
                android:paddingBottom="@dimen/_10sdp"
                android:scrollbarSize="@dimen/_6sdp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/chat_scroll_front"
                android:scrollbarTrackVertical="@drawable/chat_scroll_back"
                android:scrollbars="vertical"
                android:verticalScrollbarPosition="right"
                android:visibility="visible"
                app:allow_drag_reorder="false"
                app:allow_item_swipe="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:recyclerview_damping_ratio="DAMPING_RATIO_LOW_BOUNCY"
                app:recyclerview_fling_animation_size="1"
                app:recyclerview_overscroll_animation_size="1"

                app:recyclerview_stiffness="STIFFNESS_MEDIUM"
                app:stackFromEnd="true"
                tools:visibility="visible">

            </com.factor.bouncy.BouncyRecyclerView>
        </com.digitalbyte.samp.game.ui.FadingEdgeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chat_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/chat_fade_box"
            app:layout_constraintStart_toStartOf="@+id/chat_fade_box"
            app:layout_constraintTop_toBottomOf="@+id/chat_fade_box"
            tools:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/chat_up_butt"
                android:layout_width="35dp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chatinput"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                app:layout_constraintStart_toEndOf="@+id/chat_binder_butt"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:rotation="90"
                    android:src="@drawable/arrow_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/chat_binder_butt"
                android:layout_width="35dp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chat_input"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                app:layout_constraintStart_toEndOf="@+id/chat_input"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/binder_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chat_down_butt"
                android:layout_width="35dp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="8dp"
                android:background="@drawable/chatinput"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                app:layout_constraintStart_toEndOf="@+id/chat_up_butt"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:rotation="-90"
                    android:src="@drawable/arrow_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <EditText
                android:id="@+id/chat_input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_135sdp"
                android:autofillHints="no"
                android:background="@drawable/chatinput"
                android:clickable="true"
                android:completionThreshold="2"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/visby_round_cf_extra_bold"
                android:hint=""
                android:imeOptions="flagNoExtractUi|actionSend"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingLeft="@dimen/_3sdp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="#43FFFFFF"
                android:textCursorDrawable="@drawable/text_cursor"
                android:textIsSelectable="true"

                android:textSize="@dimen/_11sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/me_button"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@drawable/chat_input"
                android:clickable="true"
                android:fontFamily="@font/visby_round_cf_extra_bold"
                android:gravity="center"
                android:text="/me"
                android:textColor="#DDDDDB"
                android:textSize="@dimen/_6sdp"
                app:layout_constraintStart_toStartOf="@+id/chat_input"
                app:layout_constraintTop_toBottomOf="@+id/chat_input" />

            <TextView
                android:id="@+id/try_button"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@drawable/chat_input"
                android:clickable="true"
                android:fontFamily="@font/visby_round_cf_extra_bold"
                android:gravity="center"
                android:text="/try"
                android:textColor="#DDDDDB"
                android:textSize="@dimen/_6sdp"
                app:layout_constraintStart_toEndOf="@+id/me_button"
                app:layout_constraintTop_toBottomOf="@+id/chat_input" />

            <TextView
                android:id="@+id/do_button"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@drawable/chat_input"
                android:clickable="true"
                android:fontFamily="@font/visby_round_cf_extra_bold"
                android:gravity="center"
                android:text="/do"
                android:textColor="#DDDDDB"
                android:textSize="@dimen/_6sdp"
                app:layout_constraintStart_toEndOf="@+id/try_button"
                app:layout_constraintTop_toBottomOf="@+id/chat_input" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
